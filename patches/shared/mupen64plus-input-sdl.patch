+/******************************************************************
+  Function: device_is_brick
+  Purpose:  TrimUI Brick remaps the d-pad in trimui_inputd, not here.
+  output:   1 on Brick, 0 elsewhere
+*******************************************************************/
+static int device_is_brick(void)
+{
+    static int brick = -1;
+    if (brick < 0) {
+        const char* d = getenv("DEVICE");
+        brick = (d && strcmp(d, "brick") == 0) ? 1 : 0;
+    }
+    return brick;
+}
+
+/******************************************************************
+  Function: input_mode_default
+  Purpose:  D-pad mode used when the per-game file has no setting.
+  output:   0 = joystick, 1 = dpad
+*******************************************************************/
+static int input_mode_default(void)
+{
+    static int dflt = -1;
+    if (dflt < 0) {
+        /* Devices with a real analog stick keep the d-pad as the N64 d-pad;
+         * Brick has no stick, so the d-pad has to stand in for one. */
+        dflt = device_is_brick() ? 0 : 1;
+    }
+    return dflt;
+}
+
+/******************************************************************
+  Function: get_input_mode
+  Purpose:  Read the per-game d-pad mode written by the overlay.
+  input:    none
+  output:   0 = joystick (physical d-pad drives the N64 analog stick)
+            1 = dpad (physical d-pad stays the N64 d-pad)
+*******************************************************************/
+static int get_input_mode(void)
+{
+    static const char* path = NULL;
+    static int path_checked = 0;
+    static time_t mtime = 0;
+    static long file_size = -1;
+    static int loaded = 0;
+    static int mode = -1;
+
+    if (!path_checked) {
+        path = getenv("EMU_INPUT_MODE_FILE");
+        path_checked = 1;
+    }
+    if (mode < 0)
+        mode = input_mode_default();
+    if (!path || path[0] == '\0')
+        return mode;
+
+    {
+        struct stat st;
+        if (stat(path, &st) != 0) {
+            /* The overlay deletes the per-game file when the user restores
+             * defaults: fall back to the device default without a restart. */
+            mode = input_mode_default();
+            loaded = 0;
+            mtime = 0;
+            file_size = -1;
+            return mode;
+        }
+        /* FAT timestamps have 2-second granularity, so compare the size too:
+         * "joystick" and "dpad" differ in length, which makes a toggle visible
+         * even when both writes land in the same timestamp tick. */
+        if (loaded && st.st_mtime == mtime && (long)st.st_size == file_size)
+            return mode;
+        mtime = st.st_mtime;
+        file_size = (long)st.st_size;
+        loaded = 1;
+    }
+
+    {
+        FILE* f = fopen(path, "r");
+        char line[256];
+        int in_section = 0;
+        if (!f)
+            return mode;
+        while (fgets(line, sizeof(line), f)) {
+            char* p = line;
+            while (*p == ' ' || *p == '\t')
+                p++;
+            if (*p == '[') {
+                in_section = (strncmp(p, "[Leaf-Input]", 12) == 0 ||
+                              strncmp(p, "[NextUI-Input]", 14) == 0);
+                continue;
+            }
+            if (in_section && strncmp(p, "input_mode", 10) == 0) {
+                char* eq = strchr(p, '=');
+                char* val;
+                if (!eq)
+                    continue;
+                val = eq + 1;
+                while (*val == ' ' || *val == '\t')
+                    val++;
+                mode = (strncmp(val, "dpad", 4) == 0) ? 1 : 0;
+            }
+        }
+        fclose(f);
+    }
+    return mode;
+}
