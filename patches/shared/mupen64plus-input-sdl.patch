+    /* Per-game d-pad mode, for devices whose d-pad is a real SDL hat.
+     * "joystick" routes the hat through the N64 analog stick, so games that
+     * only read the stick can still be steered with it; the N64 d-pad bits are
+     * cleared because the d-pad is not a d-pad in this mode. Y is positive up
+     * and X positive right in this packed BUTTONS value, matching the axis
+     * conversion above.
+     * "dpad" forces the hat onto the N64 d-pad bits as well. The config or
+     * InputAutoCfg mapping normally does that, but full-auto mode picks a
+     * profile by SDL device name and can miss the built-in pad; doing it here
+     * makes D-Pad mode work regardless of which profile matched. The runtime
+     * remap block below still overrides these bits when the user reassigns a
+     * d-pad row.
+     * Brick is skipped: trimui_inputd already remaps the d-pad to virtual
+     * analog axes there, and doing it twice would flatten its proportional
+     * values to a digital full deflection. */
+    {
+        SDL_Joystick *joy = controller[Control].joystick;
+        if (joy && Control == 0 && !device_is_brick()) {
+            Uint8 hat = SDL_JoystickGetHat(joy, 0);
+            if (hat != SDL_HAT_CENTERED) {
+                if (get_input_mode() == 0) {
+                    int hatX = 0;
+                    int hatY = 0;
+                    if (hat & SDL_HAT_LEFT)
+                        hatX = -axis_max_val;
+                    if (hat & SDL_HAT_RIGHT)
+                        hatX = axis_max_val;
+                    if (hat & SDL_HAT_UP)
+                        hatY = axis_max_val;
+                    if (hat & SDL_HAT_DOWN)
+                        hatY = -axis_max_val;
+                    if (hatX != 0 || hatY != 0) {
+                        controller[Control].buttons.X_AXIS = hatX;
+                        controller[Control].buttons.Y_AXIS = hatY;
+                        controller[Control].buttons.Value &= ~0x000F; /* N64 d-pad */
+                    }
+                } else {
+                    if (hat & SDL_HAT_RIGHT)
+                        controller[Control].buttons.Value |= 0x0001;
+                    if (hat & SDL_HAT_LEFT)
+                        controller[Control].buttons.Value |= 0x0002;
+                    if (hat & SDL_HAT_DOWN)
+                        controller[Control].buttons.Value |= 0x0004;
+                    if (hat & SDL_HAT_UP)
+                        controller[Control].buttons.Value |= 0x0008;
+                }
+            }
+        }
+    }
+
+    /* Handheld C-button remap. Devices without a right analog stick can opt
+     * in with MUPEN64PLUS_C_BUTTON_MOD=1; the Brick keeps its legacy default.
+     * R2 + ABXY sends C-buttons by physical position. R2 defaults to axis 5
+     * for TrimUI-style devices, but can be moved to a button with
+     * MUPEN64PLUS_C_BUTTON_MOD_BUTTON for devices like MLP1:
+     *   A (right) → C-Right, B (bottom) → C-Down,
+     *   X (top) → C-Up, Y (left) → C-Left.
+     *
+     * D-pad↔joystick remapping happens below and in trimui_inputd on the
+     * Brick: the kernel daemon covers Brick, the software path covers every
+     * device whose d-pad is still reported as a hat (Leaf / MLP1). */
+    {
+        static int enable_c_button_mod = -1;
+        if (enable_c_button_mod < 0) {
+            const char* flag = getenv("MUPEN64PLUS_C_BUTTON_MOD");
+            const char* d = getenv("DEVICE");
+            enable_c_button_mod =
+                ((flag && flag[0] != '\0' && strcmp(flag, "0") != 0) ||
+                 (d && strcmp(d, "brick") == 0)) ? 1 : 0;
+        }
+      if (enable_c_button_mod) {
+        SDL_Joystick *joy = controller[Control].joystick;
+        if (joy && Control == 0) {
+            static int mod_button = -2;
+            static int mod_axis = -2;
+            static int a_button = -2;
+            static int b_button = -2;
+            static int x_button = -2;
+            static int y_button = -2;
+            if (mod_button == -2) {
+                const char* v = getenv("MUPEN64PLUS_C_BUTTON_MOD_BUTTON");
+                mod_button = (v && v[0] != '\0') ? atoi(v) : -1;
+            }
+            if (mod_axis == -2) {
+                const char* v = getenv("MUPEN64PLUS_C_BUTTON_MOD_AXIS");
+                mod_axis = (v && v[0] != '\0') ? atoi(v) : 5;
+            }
+            if (a_button == -2) {
+                const char* v = getenv("MUPEN64PLUS_C_BUTTON_A_BUTTON");
+                a_button = (v && v[0] != '\0') ? atoi(v) : 1;
+            }
+            if (b_button == -2) {
+                const char* v = getenv("MUPEN64PLUS_C_BUTTON_B_BUTTON");
+                b_button = (v && v[0] != '\0') ? atoi(v) : 0;
+            }
+            if (x_button == -2) {
+                const char* v = getenv("MUPEN64PLUS_C_BUTTON_X_BUTTON");
+                x_button = (v && v[0] != '\0') ? atoi(v) : 3;
+            }
+            if (y_button == -2) {
+                const char* v = getenv("MUPEN64PLUS_C_BUTTON_Y_BUTTON");
+                y_button = (v && v[0] != '\0') ? atoi(v) : 2;
+            }
+            int mod_held = 0;
+            if (mod_button >= 0 && mod_button < SDL_JoystickNumButtons(joy))
+                mod_held = SDL_JoystickGetButton(joy, mod_button) != 0;
+            if (!mod_held && mod_axis >= 0 && mod_axis < SDL_JoystickNumAxes(joy))
+                mod_held = SDL_JoystickGetAxis(joy, mod_axis) > 0;
+            if (mod_held) {
+                if (a_button >= 0 && a_button < SDL_JoystickNumButtons(joy) &&
+                    SDL_JoystickGetButton(joy, a_button)) { /* A (right) → C-Right */
+                    controller[Control].buttons.Value &= ~0x0080; /* clear A_BUTTON */
+                    controller[Control].buttons.Value |=  0x0100; /* set R_CBUTTON */
+                }
+                if (b_button >= 0 && b_button < SDL_JoystickNumButtons(joy) &&
+                    SDL_JoystickGetButton(joy, b_button)) { /* B (bottom) → C-Down */
+                    controller[Control].buttons.Value &= ~0x0040; /* clear B_BUTTON */
+                    controller[Control].buttons.Value |=  0x0400; /* set D_CBUTTON */
+                }
+                if (x_button >= 0 && x_button < SDL_JoystickNumButtons(joy) &&
+                    SDL_JoystickGetButton(joy, x_button)) { /* X (top) → C-Up */
+                    controller[Control].buttons.Value &= ~0x0200; /* clear C-Left from config */
+                    controller[Control].buttons.Value |=  0x0800; /* set U_CBUTTON */
+                }
+                if (y_button >= 0 && y_button < SDL_JoystickNumButtons(joy) &&
+                    SDL_JoystickGetButton(joy, y_button)) { /* Y (left) → C-Left */
+                    controller[Control].buttons.Value &= ~0x0400; /* clear C-Down from config */
+                    controller[Control].buttons.Value |=  0x0200; /* set L_CBUTTON */
+                }
+            }
+        }
+      }
+    }
+
+    /* Runtime button remapping from $EMU_BUTTON_MAP_FILE. The overlay writes
+     * this file whenever the user changes a binding; we stat() it each frame
+     * and re-parse only when the mtime changes. Each line is:
+     *   <n64_bit_hex> <type> <id> [<dir>] [<mod_type> <mod_id>]
+     * where type is 'b' (button), 'a' (axis) or 'h' (hat direction), id is the
+     * SDL index, dir is +1/-1 for axes or the SDL_HAT_* bit for hats, and the
+     * mod fields describe the modifier key. */
+    {
+        /* N64 button bits used in controller.buttons.Value */
+        #define N64_A      0x0080
+        #define N64_B      0x0040
+        #define N64_START  0x0010
+        #define N64_Z      0x0020
+        #define N64_L      0x2000
+        #define N64_R      0x1000
+        #define N64_CU     0x0800
+        #define N64_CD     0x0400
+        #define N64_CL     0x0200
+        #define N64_CR     0x0100
+        #define MAX_REMAPS 16
+
+        typedef struct {
+            unsigned int n64_bit;
+            int is_axis;    /* 0 = button, 1 = axis, 2 = hat direction */
+            int id;         /* SDL button, axis or hat index */
+            int axis_dir;   /* +1/-1 for axes, SDL_HAT_* bit for hats */
+            int mod_type;   /* 0 = none, 1 = button modifier */
+            int mod_id;     /* SDL button index for modifier */
+        } ButtonRemap;
+
+        static ButtonRemap remaps[MAX_REMAPS];
+        static int remap_count = 0;
+        static time_t remap_mtime = 0;
+        static const char* remap_path = NULL;
+        static int remap_path_checked = 0;
+
+        if (!remap_path_checked) {
+            remap_path = getenv("EMU_BUTTON_MAP_FILE");
+            remap_path_checked = 1;
+        }
+
+        if (remap_path && remap_path[0] != '\0') {
+            struct stat st;
+            if (stat(remap_path, &st) == 0 && st.st_mtime != remap_mtime) {
+                remap_mtime = st.st_mtime;
+                remap_count = 0;
+                FILE* f = fopen(remap_path, "r");
+                if (f) {
+                    char line[256];
+                    while (fgets(line, sizeof(line), f) && remap_count < MAX_REMAPS) {
+                        ButtonRemap* r = &remaps[remap_count];
+                        unsigned int bit;
+                        char type;
+                        int id, dir = 0, mt = 0, mid = -1;
+                        int n = sscanf(line, "%x %c %d %d %d %d",
+                                       &bit, &type, &id, &dir, &mt, &mid);
+                        if (n >= 3) {
+                            r->n64_bit = bit;
+                            r->is_axis = (type == 'a') ? 1 : ((type == 'h') ? 2 : 0);
+                            r->id = id;
+                            r->axis_dir = dir;
+                            r->mod_type = mt;
+                            r->mod_id = mid;
+                            remap_count++;
+                        }
+                    }
+                    fclose(f);
+                }
+            }
+
+            SDL_Joystick *joy = controller[Control].joystick;
+            if (joy && Control == 0 && remap_count > 0) {
+                /* The built-in d-pad is a button source only in D-Pad mode. In
+                 * Joystick mode it drives the N64 analog stick, so bindings
+                 * such as C-Up = D-Pad Up are inactive. */
+                const int dpad_is_button_source = (get_input_mode() != 0);
+
+                /* Hat-sourced bindings are additive: they never clear the
+                 * target action's other sources (so R2+X still sends C-Up).
+                 * A direction claimed by an unmodified action binding stops
+                 * being an N64 d-pad direction instead, which lets the d-pad
+                 * act as C-Up/Down/Left/Right. Directions no action claims
+                 * keep their normal N64 d-pad behaviour. */
+                unsigned int remap_mask = 0;
+                unsigned int claimed_dpad = 0;
+                for (int i = 0; i < remap_count; i++) {
+                    ButtonRemap* r = &remaps[i];
+                    if (r->is_axis == 2) {
+                        if (dpad_is_button_source && r->id == 0 &&
+                            r->mod_type == 0 && (r->n64_bit & 0x000F) == 0)
+                            claimed_dpad |= (r->axis_dir & 0x000F);
+                        continue;
+                    }
+                    remap_mask |= r->n64_bit;
+                }
+                controller[Control].buttons.Value &= ~(remap_mask | claimed_dpad);
+
+                for (int i = 0; i < remap_count; i++) {
+                    ButtonRemap* r = &remaps[i];
+                    int pressed = 0;
+                    if (r->is_axis == 2) {
+                        if (r->id == 0 && !dpad_is_button_source)
+                            continue;
+                        pressed = (SDL_JoystickGetHat(joy, r->id) & r->axis_dir) != 0;
+                    } else if (r->is_axis) {
+                        int val = SDL_JoystickGetAxis(joy, r->id);
+                        pressed = (r->axis_dir > 0) ? (val > 24000) : (val < -24000);
+                    } else {
+                        pressed = SDL_JoystickGetButton(joy, r->id);
+                    }
+                    /* Check modifier if required */
+                    if (r->mod_type == 1 && r->mod_id >= 0) {
+                        /* Button modifier (MENU, SELECT) */
+                        if (!SDL_JoystickGetButton(joy, r->mod_id))
+                            pressed = 0;
+                    } else if (r->mod_type == 2 && r->mod_id >= 0) {
+                        /* Axis modifier (L2, R2) — held when past threshold */
+                        int mod_val = SDL_JoystickGetAxis(joy, r->mod_id);
+                        if (mod_val < 24000 && mod_val > -24000)
+                            pressed = 0;
+                    }
+                    if (pressed)
+                        controller[Control].buttons.Value |= r->n64_bit;
+                }
+            }
+        }
+    }
+
